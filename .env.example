# Database
DATABASE_URL="postgresql://user:password@localhost:5432/recipe_tracker"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # Generate with: openssl rand -base64 32

# File Storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# Supabase (for real-time sync)
NEXT_PUBLIC_SUPABASE_URL="" # Your Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY="" # Your Supabase anon/public key

# Sentry (Error Tracking)
SENTRY_DSN="" # Your Sentry DSN for server-side error tracking
NEXT_PUBLIC_SENTRY_DSN="" # Your Sentry DSN for client-side error tracking
SENTRY_AUTH_TOKEN="" # Sentry auth token for uploading source maps (CI/CD only)

# Vercel (Deployment)
VERCEL_TOKEN="" # Vercel API token (for CI/CD deployments)
VERCEL_ORG_ID="" # Your Vercel organization ID
VERCEL_PROJECT_ID="" # Your Vercel project ID

# Application
NODE_ENV="development"

# Optional: Set to 'true' to seed database on migration
SEED_DATA="false"
